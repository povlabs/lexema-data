{"schema":"lexema-content/v1","releaseId":"it-0c432803","entries":{"adj:Aggettivo":{"key":"adj:Aggettivo","sourceLineSha256":"09498149d7f7c2f3a716b92c198cfd653722d3891ae7f873dee53fa6635ad081","word":{"value":"ipocrita","source":{"line":33347,"pointer":"/word"}},"pos":{"value":"adj","source":{"line":33347,"pointer":"/pos"}},"posTitle":{"value":"Aggettivo","source":{"line":33347,"pointer":"/pos_title"}},"tags":[{"value":"masculine","source":{"line":33347,"pointer":"/tags/0"}},{"value":"singular","source":{"line":33347,"pointer":"/tags/1"}}],"rawTags":[],"senses":[{"index":0,"source":{"line":33347,"pointer":"/senses/0"},"glosses":[{"value":"che è caratterizzato dall'ipocrisia","source":{"line":33347,"pointer":"/senses/0/glosses/0"}}],"labels":[],"formOf":[]},{"index":1,"source":{"line":33347,"pointer":"/senses/1"},"glosses":[{"value":"simulatore di atteggiamenti o sentimenti esemplari per ingannare, lusingare o tenere lontano; che adotta comportamenti variabili non sinceri secondo le circostanze o le persone presenti, talvolta con la stessa persona","source":{"line":33347,"pointer":"/senses/1/glosses/0"}}],"labels":[],"formOf":[]},{"index":2,"source":{"line":33347,"pointer":"/senses/2"},"glosses":[{"value":"soggetto a smentirsi dinanzi alla verità: connaturato a falsità e/o lusinghiero con sofismi beffardi; persona bugiarda che dissimula per nascondere","source":{"line":33347,"pointer":"/senses/2/glosses/0"}}],"labels":[],"formOf":[]},{"index":3,"source":{"line":33347,"pointer":"/senses/3"},"glosses":[{"value":"che, secondo false parole e con motivi non validi ed \"ignobili\", conseguentemente \"raggira\"; che finge amicizia e/o buone intenzioni celando ostilità","source":{"line":33347,"pointer":"/senses/3/glosses/0"}}],"labels":[],"formOf":[]},{"index":4,"source":{"line":33347,"pointer":"/senses/4"},"glosses":[{"value":"chi \"aggira\" un argomento su qualcosa o qualcuno, non per evitare maldicenza bensì perché già o potenzialmente \"ostile\" a riguardo","source":{"lin