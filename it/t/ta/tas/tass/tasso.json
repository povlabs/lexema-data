{"schema":"lexema-content/v1","releaseId":"it-0c432803","entries":{"noun:Sostantivo":{"key":"noun:Sostantivo","sourceLineSha256":"ae1fbcf545ff0fff48eff0a5f97b43cb48e17fd97c5435bf7dc36b54d3d0b5fd","word":{"value":"tasso","source":{"line":32651,"pointer":"/word"}},"pos":{"value":"noun","source":{"line":32651,"pointer":"/pos"}},"posTitle":{"value":"Sostantivo","source":{"line":32651,"pointer":"/pos_title"}},"tags":[{"value":"masculine","source":{"line":32651,"pointer":"/tags/0"}},{"value":"singular","source":{"line":32651,"pointer":"/tags/1"}}],"rawTags":[],"senses":[{"index":0,"source":{"line":32651,"pointer":"/senses/0"},"glosses":[{"value":"mammifero onnivoro della famiglia dei mustelidi con muso aguzzo, corpo tozzo, pelame ispido, chiaro di sopra, bruno-nero di sotto, fasce scure sopra gli occhi e gli orecchi ; vive solitario nelle regioni boscose entro tane che si scava, in letargo tutto l'inverno; fa le prede la notte; addomesticabile, ma pronto a mordere; la carne si mangia; dei peli si fanno pennelli; la pelliccia serve per borse e bauli; la sua classificazione scientifica è Meles meles ( tassonomia)","source":{"line":32651,"pointer":"/senses/0/glosses/0"}}],"labels":[],"formOf":[]},{"index":1,"source":{"line":32651,"pointer":"/senses/1"},"glosses":[{"value":"conifera che raggiunge perfino i 10 m d'altezza con chioma arrotondata e scorza rosso-bruna, foglie acute, più scure sopra che sotto (velenose, letali, specialmente negli equini), fiori di due sorte, sopra piante distinte, gli staminiferi come piccole spighe dette amenti, gli ovuliferi isolati, la bacca, detta arillo è grossa come pisello; dei boschi montuosi; e coltivato nei giardini per ornamento; legno duro roseo usato per erbanisteria; la sua classificazione scientifica è Taxus baccata ( tassonomia)","source":{"line":32651,"pointer":"/senses/1/glosses/0"}}],"labels":[],"formOf":[]},{"index":2,"source":{"line":32651,"pointer":"/senses/2"},"glosses":[{"value":"specie di incudine usata dai fabbri per la l