{"schema":"lexema-content/v1","releaseId":"it-0c432803","entries":{"adj:Aggettivo":{"key":"adj:Aggettivo","sourceLineSha256":"84338fb78518f567067a3f38b1dba507df914142e94f9ea5f696e0b47ffb9359","word":{"value":"glauco","source":{"line":69460,"pointer":"/word"}},"pos":{"value":"adj","source":{"line":69460,"pointer":"/pos"}},"posTitle":{"value":"Aggettivo","source":{"line":69460,"pointer":"/pos_title"}},"tags":[],"rawTags":[],"senses":[{"index":0,"source":{"line":69460,"pointer":"/senses/0"},"glosses":[{"value":"colore celeste tendente al verde, verde tendente al grigio, ceruleo o celeste chiaro, usato dai poeti per la descrizione degli occhi","source":{"line":69460,"pointer":"/senses/0/glosses/0"}}],"labels":[],"formOf":[]},{"index":1,"source":{"line":69460,"pointer":"/senses/1"},"glosses":[{"value":"Scintillante, splendente come l'argento, forse il grigio brillante dell'argento, o il bianco che luccica e sembra argento, come ad esempio la luna.","source":{"line":69460,"pointer":"/senses/1/glosses/0"}}],"labels":[],"formOf":[]},{"index":2,"source":{"line":69460,"pointer":"/senses/2"},"glosses":[{"value":"Verde acqua, grigio-blu, come il mare dolce e amaro descritto da Omero.","source":{"line":69460,"pointer":"/senses/2/glosses/0"}}],"labels":[],"formOf":[]},{"index":3,"source":{"line":69460,"pointer":"/senses/3"},"glosses":[{"value":"Grigio-verde come l'oliva: costa tutta coperta del pallor glauco degli ulivi (Pascoli).","source":{"line":69460,"pointer":"/senses/3/glosses/0"}}],"labels":[],"formOf":[]},{"index":4,"source":{"line":69460,"pointer":"/senses/4"},"glosses":[{"value":"Riferito anche al tempo meteorologico (in particolare all'aria/vento), la grande frescura glauca della sera di giugno (D’Annunzio).","source":{"line":69460,"pointer":"/senses/4/glosses/0"}}],"labels":[],"formOf":[]},{"index":5,"source":{"line":69460,"pointer":"/senses/5"},"glosses":[{"value":"In alcune piante, come nelle piante grasse o nelle foglie dei giaggioli, il verde-grigio che si trova sullo strato superficiale.","source":{"line":69460,"pointer":"/senses/5/glosses/0"}}],"labels":[],"formOf":[]},{"index":6,"source":{"line":69460,"pointer":"/senses/6"},"glosses":[{"value":"Nella lingua greca antica i colori erano delle sfumature/tinte/tonalità e non dei colori specifici, andavano dalla sfumatura più chiara alla più scura. Il colore Glaukos rappresentava i colori più chiari, tra cui azzurro, giallo, grigio o verde chiaro. Kyaenos rappresentava i colori più scuri tra cui il blu scuro, viola, nero, marrone o verde scuro.","source":{"line":69460,"pointer":"/senses/6/glosses/0"}}],"labels":[],"formOf":[]}],"forms":[{"index":0,"source":{"line":69460,"pointer":"/forms/0"},"form":{"value":"glauchi","source":{"line":69460,"pointer":"/forms/0/form"}},"tags":[{"value":"masculine","source":{"line":69460,"pointer":"/forms/0/tags/0"}},{"value":"plural","source":{"line":69460,"pointer":"/forms/0/tags/1"}}],"rawTags":[]},{"index":1,"source":{"line":69460,"pointer":"/forms/1"},"form":{"value":"glauca","source":{"line":69460,"pointer":"/forms/1/form"}},"tags":[{"value":"feminine","source":{"line":69460,"pointer":"/forms/1/tags/0"}},{"value":"singular","source":{"line":69460,"pointer":"/forms/1/tags/1"}}],"rawTags":[]},{"index":2,"source":{"line":69460,"pointer":"/forms/2"},"form":{"value":"glauche","source":{"line":69460,"pointer":"/forms/2/form"}},"tags":[{"value":"feminine","source":{"line":69460,"pointer":"/forms/2/tags/0"}},{"value":"plural","source":{"line":69460,"pointer":"/forms/2/tags/1"}}],"rawTags":[]}],"grammar":{"record":[{"status":"missing","dimension":"gender","source":{"line":69460,"pointer":""}},{"status":"missing","dimension":"number","source":{"line":69460,"pointer":""}}],"senses":[],"forms":[{"index":0,"claim":{"status":"stated","dimension":"gender","value":"masculine","sourceText":"masculine","source":{"line":69460,"pointer":"/forms/0/tags/0"}}},{"index":0,"claim":{"status":"stated","dimension":"number","value":"plural","sourceText":"plural","sourc