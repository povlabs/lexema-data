{"schema":"lexema-content/v1","releaseId":"it-0c432803","entries":{"noun:Sostantivo":{"key":"noun:Sostantivo","sourceLineSha256":"ae0bc3b02cf8f0b35154f148ca2725a15e96da44bece1399524be5e8d3a285e2","word":{"value":"gavetta","source":{"line":107023,"pointer":"/word"}},"pos":{"value":"noun","source":{"line":107023,"pointer":"/pos"}},"posTitle":{"value":"Sostantivo","source":{"line":107023,"pointer":"/pos_title"}},"tags":[{"value":"feminine","source":{"line":107023,"pointer":"/tags/0"}},{"value":"singular","source":{"line":107023,"pointer":"/tags/1"}}],"rawTags":[],"senses":[{"index":0,"source":{"line":107023,"pointer":"/senses/0"},"glosses":[{"value":"recipiente in metallo, alluminio o acciaio inox, utilizzato dai militari durante il servizio di leva per conservare il pasto. Composta generalmente di due pezzi che si incastrano tra di loro, un contenitore che può fungere da ciotola o da pentolino e un coperchio che può fungere da piatto. Veniva usata per trasportare e consumare il cibo in situazioni in cui non era possibile cucinare (come sui luoghi di lavoro, al campeggio o dagli scout); è spesso sostituita da contenitori in plastica o dai piatti usa e getta. E' ancora usata nell'ambito del campeggio in quanto può essere usata sia per cucinare con il fornelletto che come piatto.","source":{"line":107023,"pointer":"/senses/0/glosses/0"}}],"labels":[],"formOf":[]},{"index":1,"source":{"line":107023,"pointer":"/senses/1"},"glosses":[{"value":"sinonimo di spago","source":{"line":107023,"pointer":"/senses/1/glosses/0"}}],"labels":[],"formOf":[]}],"forms":[{"index":0,"source":{"line":107023,"pointer":"/forms/0"},"form":{"value":"gavette","source":{"line":107023,"pointer":"/forms/0/form"}},"tags":[{"value":"plural","source":{"line":107023,"pointer":"/forms/0/tags/0"}}],"rawTags":[]}],"grammar":{"record":[{"status":"stated","dimension":"gender","value":"feminine","sourceText":"feminine","source":{"line":107023,"pointer":"/tags/0"}},{"status":"stated","dimension":"number","value