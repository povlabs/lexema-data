{"schema":"lexema-content/v1","releaseId":"it-0c432803","entries":{"noun:Sostantivo":{"key":"noun:Sostantivo","sourceLineSha256":"4661407a09cf3527732b6629b0029bead9f286eab5b6e995268252353545c61e","word":{"value":"sostanza","source":{"line":54180,"pointer":"/word"}},"pos":{"value":"noun","source":{"line":54180,"pointer":"/pos"}},"posTitle":{"value":"Sostantivo","source":{"line":54180,"pointer":"/pos_title"}},"tags":[{"value":"feminine","source":{"line":54180,"pointer":"/tags/0"}},{"value":"singular","source":{"line":54180,"pointer":"/tags/1"}}],"rawTags":[],"senses":[{"index":0,"source":{"line":54180,"pointer":"/senses/0"},"glosses":[{"value":"ciò che si trova all'interno di un oggetto sensibile col fine di reggerlo","source":{"line":54180,"pointer":"/senses/0/glosses/0"}}],"labels":[],"formOf":[]},{"index":1,"source":{"line":54180,"pointer":"/senses/1"},"glosses":[{"value":"l'insieme di un'idea e della sua rappresentazione ovvero l'archetipo ed il fenomeno, altrimenti detti essenza e forma che, qualora fosse il “delinearsi” dell’oggetto secondo la propria natura, verrebbe accettata come “qualità intrinseca alla sostanza”, da cui l’interscambievole significato per essa, ovvero “forma in quanto essenza” oppure “forma in quanto qualità”…","source":{"line":54180,"pointer":"/senses/1/glosses/0"}}],"labels":[{"value":"broadly","source":{"line":54180,"pointer":"/senses/1/tags/0"},"kind":"tag"}],"formOf":[]},{"index":2,"source":{"line":54180,"pointer":"/senses/2"},"glosses":[{"value":"sistema omogeneo di composizione definita e costante, caratterizzato da proprietà chimiche e fisiche specifiche","source":{"line":54180,"pointer":"/senses/2/glosses/0"}}],"labels":[],"formOf":[]},{"index":3,"source":{"line":54180,"pointer":"/senses/3"},"glosses":[{"value":"patrimonio","source":{"line":54180,"pointer":"/senses/3/glosses/0"}}],"labels":[{"value":"figuratively","source":{"line":54180,"pointer":"/senses/3/tags/0"},"kind":"tag"}],"formOf":[]},{"index":4,"source":{"line":54180,"poin