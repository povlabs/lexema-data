{"schema":"lexema-content/v1","releaseId":"it-0c432803","entries":{"noun:Sostantivo":{"key":"noun:Sostantivo","sourceLineSha256":"33afaa2f92e354582c7df582d69f2c92443436768dd36d7d99b36a71e43bb2e3","word":{"value":"svinatura","source":{"line":17637,"pointer":"/word"}},"pos":{"value":"noun","source":{"line":17637,"pointer":"/pos"}},"posTitle":{"value":"Sostantivo","source":{"line":17637,"pointer":"/pos_title"}},"tags":[{"value":"feminine","source":{"line":17637,"pointer":"/tags/0"}},{"value":"singular","source":{"line":17637,"pointer":"/tags/1"}}],"rawTags":[],"senses":[{"index":0,"source":{"line":17637,"pointer":"/senses/0"},"glosses":[{"value":"nella vinificazione in rosso, la raccolta del vino, terminata la fermentazione alcolica, in un recipiente e la separazione della vinaccia restante nella pressa o nel torchio per esaurirla. Questo passaggio può essere effettuato manualmente (spontaneamente per gravità) o meccanicamente mandando il liquido allo svinatore, il quale provvederà a separare quelle vinacce ancora “fluttuanti” dentro la frazione liquida. Il passaggio in vasca presenta il vantaggio di omogeneizzare la massa e di facilitare l'eventuale completamento delle fermentazioni assicurando la ripartizione omogenea di lieviti e batteri","source":{"line":17637,"pointer":"/senses/0/glosses/0"}}],"labels":[{"value":"enologia","source":{"line":17637,"pointer":"/senses/0/raw_tags/0"},"kind":"raw_tag"}],"formOf":[]},{"index":1,"source":{"line":17637,"pointer":"/senses/1"},"glosses":[{"value":"ottenimento del vino (rosso) nuovo dal recipiente in cui è avvenuta la trasformazione da mosto. Separazione da vinacce fermentate.","source":{"line":17637,"pointer":"/senses/1/glosses/0"}}],"labels":[{"value":"broadly","source":{"line":17637,"pointer":"/senses/1/tags/0"},"kind":"tag"}],"formOf":[]}],"forms":[{"index":0,"source":{"line":17637,"pointer":"/forms/0"},"form":{"value":"svinature","source":{"line":17637,"pointer":"/forms/0/form"}},"tags":[{"value":"plural","source":{"line