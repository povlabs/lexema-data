{"schema":"lexema-content/v1","releaseId":"it-0c432803","entries":{"verb:Verbo":{"key":"verb:Verbo","sourceLineSha256":"0ffd81c070e554dd67f4f61b84a93fc2cd868fed94185e54a803f88556899e46","word":{"value":"liberarsi","source":{"line":48690,"pointer":"/word"}},"pos":{"value":"verb","source":{"line":48690,"pointer":"/pos"}},"posTitle":{"value":"Verbo","source":{"line":48690,"pointer":"/pos_title"}},"tags":[{"value":"reflexive","source":{"line":48690,"pointer":"/tags/0"}}],"rawTags":[],"senses":[{"index":0,"source":{"line":48690,"pointer":"/senses/0"},"glosses":[{"value":"non essere più vincolato ad un'abitudine o ad un vizio","source":{"line":48690,"pointer":"/senses/0/glosses/0"}}],"labels":[],"formOf":[]},{"index":1,"source":{"line":48690,"pointer":"/senses/1"},"glosses":[{"value":"è il suo contrario ovvero disinibirsi con accezione “negativa”, in particolare in un ambito equivoco sia esso per droga, alcol, sessualità, ecc. È quindi un riferimento al libero arbitrio però con una scelta immorale e “poco sana”","source":{"line":48690,"pointer":"/senses/1/glosses/0"}}],"labels":[{"value":"slang","source":{"line":48690,"pointer":"/senses/1/tags/0"},"kind":"tag"}],"formOf":[]},{"index":2,"source":{"line":48690,"pointer":"/senses/2"},"glosses":[{"value":"escludere qualcuno dalle proprie frequentazioni, nel lavoro, non considerare abbastanza una persona come amico, socio, qualcuno con cui poter comunicare, dialogare, condividere…","source":{"line":48690,"pointer":"/senses/2/glosses/0"}}],"labels":[{"value":"broadly","source":{"line":48690,"pointer":"/senses/2/tags/0"},"kind":"tag"}],"formOf":[]},{"index":3,"source":{"line":48690,"pointer":"/senses/3"},"glosses":[{"value":"“eliminare qualcuno”, uccidere","source":{"line":48690,"pointer":"/senses/3/glosses/0"}}],"labels":[{"value":"rare","source":{"line":48690,"pointer":"/senses/3/tags/0"},"kind":"tag"}],"formOf":[]},{"index":4,"source":{"line":48690,"pointer":"/senses/4"},"glosses":[{"value":"“togliere di mezzo”, “far fuori… qualcuno”","source":{"line":48690,"pointer":"/senses/4/glosses/0"}}],"labels":[{"value":"broadly","source":{"line":48690,"pointer":"/senses/4/tags/0"},"kind":"tag"}],"formOf":[]},{"index":5,"source":{"line":48690,"pointer":"/senses/5"},"glosses":[{"value":"con riferimento ad oggetti, significa abbandonare, gettare, buttare qualcosa a cui non si è più legati, senza più utilità oppure proprio perché troppo vincolati ad esso…","source":{"line":48690,"pointer":"/senses/5/glosses/0"}}],"labels":[],"formOf":[]},{"index":6,"source":{"line":48690,"pointer":"/senses/6"},"glosses":[{"value":"espletare le necessità fisiche e del corpo","source":{"line":48690,"pointer":"/senses/6/glosses/0"}}],"labels":[{"value":"familiare","source":{"line":48690,"pointer":"/senses/6/raw_tags/0"},"kind":"raw_tag"}],"formOf":[]},{"index":7,"source":{"line":48690,"pointer":"/senses/7"},"glosses":[{"value":"“togliere” una “parte malata” del corpo, solitamente affiorata o “spuntata”: un “brufoletto”, una ferita, anche un “mal di testa”, ecc.","source":{"line":48690,"pointer":"/senses/7/glosses/0"}}],"labels":[{"value":"broadly","source":{"line":48690,"pointer":"/senses/7/tags/0"},"kind":"tag"}],"formOf":[]},{"index":8,"source":{"line":48690,"pointer":"/senses/8"},"glosses":[{"value":"“togliersi un dubbio”, aver risolto un “dilemma” che lasciava più che perplesso qualcuno… quindi per molto tempo","source":{"line":48690,"pointer":"/senses/8/glosses/0"}}],"labels":[],"formOf":[]},{"index":9,"source":{"line":48690,"pointer":"/senses/9"},"glosses":[{"value":"uscire da una mossa… “bloccato, un avversario ne esce”, per esempio nella lotta, comunque nello sport","source":{"line":48690,"pointer":"/senses/9/glosses/0"}}],"labels":[],"formOf":[]}],"forms":[],"grammar":{"record":[{"status":"stated","dimension":"voice","value":"reflexive","sourceText":"reflexive","source":{"line":48690,"pointer":"/tags/0"}}],"senses":[{"index":6,"claim":{"status":"unclassified","sourceText":"familiare","source":{"line":48690,"pointer":"/senses/6/raw_tags/0"}}}],"forms":[]}}}}
