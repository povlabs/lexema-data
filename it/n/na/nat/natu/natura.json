ri, ecc: l'insieme vegetale \"inanimato\"","source":{"line":51922,"pointer":"/senses/4/glosses/0"}}],"labels":[{"value":"broadly","source":{"line":51922,"pointer":"/senses/4/tags/0"},"kind":"tag"},{"value":"figuratively","source":{"line":51922,"pointer":"/senses/4/tags/1"},"kind":"tag"},{"value":"slang","source":{"line":51922,"pointer":"/senses/4/tags/2"},"kind":"tag"}],"formOf":[]},{"index":5,"source":{"line":51922,"pointer":"/senses/5"},"glosses":[{"value":"è “la più intima essenza”, in filosofia individuata anche nella sostanza come correlazione tra archetipo e forma, appunto con la “possibilità” che qualcuno e/o qualcosa possano “esplicitarsi” con modalità precipue e proprie di questa stessa affinché possa essere conosciuta ed “indagata”","source":{"line":51922,"pointer":"/senses/5/glosses/0"}}],"labels":[{"value":"figuratively","source":{"line":51922,"pointer":"/senses/5/tags/0"},"kind":"tag"}],"formOf":[]}],"forms":[{"index":0,"source":{"line":51922,"pointer":"/forms/0"},"form":{"value":"nature","source":{"line":51922,"pointer":"/forms/0/form"}},"tags":[{"value":"plural","source":{"line":51922,"pointer":"/forms/0/tags/0"}}],"rawTags":[]}],"grammar":{"record":[{"status":"stated","dimension":"gender","value":"feminine","sourceText":"feminine","source":{"line":51922,"pointer":"/tags/0"}},{"status":"stated","dimension":"number","value":"singular","sourceText":"singular","source":{"line":51922,"pointer":"/tags/1"}}],"senses":[],"forms":[{"index":0,"claim":{"status":"stated","dimension":"number","value":"plural","sourceText":"plural","source":{"line":51922,"pointer":"/forms/0/tags/0"}}}]}}}}
