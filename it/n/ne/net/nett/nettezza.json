{"schema":"lexema-content/v1","releaseId":"it-0c432803","entries":{"noun:Sostantivo":{"key":"noun:Sostantivo","sourceLineSha256":"8b2cff0227d57ce10de85685cf380026859807e1a00d55e4558360ee40d3068a","word":{"value":"nettezza","source":{"line":51968,"pointer":"/word"}},"pos":{"value":"noun","source":{"line":51968,"pointer":"/pos"}},"posTitle":{"value":"Sostantivo","source":{"line":51968,"pointer":"/pos_title"}},"tags":[{"value":"feminine","source":{"line":51968,"pointer":"/tags/0"}}],"rawTags":[],"senses":[{"index":0,"source":{"line":51968,"pointer":"/senses/0"},"glosses":[{"value":"Il termine nettezza significa pulizia, l'esser netto, lindo. Per estensione anche in riferimento al carattere indica onestà, rettitudine. In realtà essendo chiamato, specie nel centro Italia, servizio di nettezza urbana quel servizio che si occupava di raccogliere l'immondizia e pulire le strade nelle città, il termine nettezza, forse per ignoranza popolare, assume anche il significato opposto a quello etimologico giungendo a significare spazzatura, sozzume","source":{"line":51968,"pointer":"/senses/0/glosses/0"}}],"labels":[],"formOf":[]}],"forms":[{"index":0,"source":{"line":51968,"pointer":"/forms/0"},"form":{"value":"nettezze","source":{"line":51968,"pointer":"/forms/0/form"}},"tags":[{"value":"plural","source":{"line":51968,"pointer":"/forms/0/tags/0"}}],"rawTags":[]}],"grammar":{"record":[{"status":"stated","dimension":"gender","value":"feminine","sourceText":"feminine","source":{"line":51968,"pointer":"/tags/0"}},{"status":"missing","dimension":"number","source":{"line":51968,"pointer":""}}],"senses":[],"forms":[{"index":0,"claim":{"status":"stated","dimension":"number","value":"plural","sourceText":"plural","source":{"line":51968,"pointer":"/forms/0/tags/0"}}}]}}}}
