{"schema":"lexema-content/v1","releaseId":"it-0c432803","entries":{"noun:Sostantivo":{"key":"noun:Sostantivo","sourceLineSha256":"1619632ebdc11dd034df96d1ef61ac19eaba46255029c05533cbe133106988bf","word":{"value":"cortile","source":{"line":137633,"pointer":"/word"}},"pos":{"value":"noun","source":{"line":137633,"pointer":"/pos"}},"posTitle":{"value":"Sostantivo","source":{"line":137633,"pointer":"/pos_title"}},"tags":[{"value":"masculine","source":{"line":137633,"pointer":"/tags/0"}},{"value":"singular","source":{"line":137633,"pointer":"/tags/1"}}],"rawTags":[],"senses":[{"index":0,"source":{"line":137633,"pointer":"/senses/0"},"glosses":[{"value":"spazio scoperto all'interno di uno o più edifici urbani adiacenti oppure intorno a un condominio, una abitazione singola o un palazzo. Le sue funzioni principali sono permettere il passaggio in ambienti e stanze illuminati e areati. Tra le funzioni secondarie quelle di presentare pregi di arte, architettura e botanica, e quella di luogo di riunione e intrattenimento.","source":{"line":137633,"pointer":"/senses/0/glosses/0"}}],"labels":[{"value":"urbanistica","source":{"line":137633,"pointer":"/senses/0/raw_tags/0"},"kind":"raw_tag"}],"formOf":[]},{"index":1,"source":{"line":137633,"pointer":"/senses/1"},"glosses":[{"value":"(in campagna) spazio scoperto o recinto attorno alla fattoria, o alla cascina o alla casa colonica o alla azienda, funzionale anche per l'allevamento di animali detti appunto da cortile.","source":{"line":137633,"pointer":"/senses/1/glosses/0"}}],"labels":[],"formOf":[]}],"forms":[{"index":0,"source":{"line":137633,"pointer":"/forms/0"},"form":{"value":"cortili","source":{"line":137633,"pointer":"/forms/0/form"}},"tags":[{"value":"plural","source":{"line":137633,"pointer":"/forms/0/tags/0"}}],"rawTags":[]}],"grammar":{"record":[{"status":"stated","dimension":"gender","value":"masculine","sourceText":"masculine","source":{"line":137633,"pointer":"/tags/0"}},{"status":"stated","dimension":"number","value