{"schema":"lexema-content/v1","releaseId":"it-0c432803","entries":{"noun:Sostantivo":{"key":"noun:Sostantivo","sourceLineSha256":"2b0db2d5f5451bc0bb3ad6dc8dc60c68daf66a5cfa44ae99ec8d4dc71da9a3fe","word":{"value":"cardiomiopatia","source":{"line":101258,"pointer":"/word"}},"pos":{"value":"noun","source":{"line":101258,"pointer":"/pos"}},"posTitle":{"value":"Sostantivo","source":{"line":101258,"pointer":"/pos_title"}},"tags":[{"value":"feminine","source":{"line":101258,"pointer":"/tags/0"}},{"value":"singular","source":{"line":101258,"pointer":"/tags/1"}}],"rawTags":[],"senses":[{"index":0,"source":{"line":101258,"pointer":"/senses/0"},"glosses":[{"value":"patologia a carico del muscolo cardiaco (miocardio) associata ad una disfunzione elettrica e/o meccanica non conseguente a coronaropatie, ipertensione sistemica o polmonare, difetti valvolari o malattie pericardiche, bensì ad un vasto insieme di cause frequentemente di natura genetica. In genere (ma non in tutti i casi) la cardiomiopatia si manifesta come abnorme dilatazione o ipertrofia ventricolare. Si distinguono cardiomiopatie primitive (confinate al solo miocardio) e cardiomiopatie secondarie (nelle quali la patologia miocardica è espressione di una più vasta malattia multiorgano)","source":{"line":101258,"pointer":"/senses/0/glosses/0"}}],"labels":[],"formOf":[]}],"forms":[{"index":0,"source":{"line":101258,"pointer":"/forms/0"},"form":{"value":"cardiomiopatie","source":{"line":101258,"pointer":"/forms/0/form"}},"tags":[{"value":"plural","source":{"line":101258,"pointer":"/forms/0/tags/0"}}],"rawTags":[]}],"grammar":{"record":[{"status":"stated","dimension":"gender","value":"feminine","sourceText":"feminine","source":{"line":101258,"pointer":"/tags/0"}},{"status":"stated","dimension":"number","value":"singular","sourceText":"singular","source":{"line":101258,"pointer":"/tags/1"}}],"senses":[],"forms":[{"index":0,"claim":{"status":"stated","dimension":"number","value":"plural","sourceText":"plural","source":{"l