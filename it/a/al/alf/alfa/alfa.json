:{"line":47368,"pointer":"/senses/6/glosses/0"}}],"labels":[],"formOf":[]},{"index":7,"source":{"line":47368,"pointer":"/senses/7"},"glosses":[{"value":"posizione in cui, in un composto, è avvenuta una data sostituzione: se il composto è alifatico, la sostituzione interessa l' atomo di carbonio a cui è unito pure il gruppo principale, se è aromatico, a più nuclei, alfa indica che la sostituzione interessa uno degli atomi di carbonio in posizione 1 o 4 o 5 o 8; se il composto è eterociclico indica l' atomo di carbonio immediatamente vicino all' eteroatomo.","source":{"line":47368,"pointer":"/senses/7/glosses/0"}}],"labels":[],"formOf":[]},{"index":8,"source":{"line":47368,"pointer":"/senses/8"},"glosses":[{"value":"nella nomenclatura degli zuccheri, indica uno dei due isomeri che si formano quando lo zucchero passa dalla struttura aperta a quella chiusa (semiacetalica)","source":{"line":47368,"pointer":"/senses/8/glosses/0"}}],"labels":[],"formOf":[]},{"index":9,"source":{"line":47368,"pointer":"/senses/9"},"glosses":[{"value":"coefficiente di dilatazione termica lineare in termologia","source":{"line":47368,"pointer":"/senses/9/glosses/0"}}],"labels":[],"formOf":[]},{"index":10,"source":{"line":47368,"pointer":"/senses/10"},"glosses":[{"value":"coefficiente termico di resistività in elettrologia","source":{"line":47368,"pointer":"/senses/10/glosses/0"}}],"labels":[],"formOf":[]},{"index":11,"source":{"line":47368,"pointer":"/senses/11"},"glosses":[{"value":"angolo","source":{"line":47368,"pointer":"/senses/11/glosses/0"}}],"labels":[],"formOf":[]},{"index":12,"source":{"line":47368,"pointer":"/senses/12"},"glosses":[{"value":"coseno direttore","source":{"line":47368,"pointer":"/senses/12/glosses/0"}}],"labels":[],"formOf":[]}],"forms":[],"grammar":{"record":[{"status":"stated","dimension":"gender","value":"feminine","sourceText":"feminine","source":{"line":47368,"pointer":"/tags/0"}},{"status":"missing","dimension":"number","source":{"line":47368,"pointer":""}}],"se