{"schema":"lexema-content/v1","releaseId":"it-0c432803","entries":{"noun:Sostantivo":{"key":"noun:Sostantivo","sourceLineSha256":"a13e31f037275ffa40a5829085874111f453508e9f5a316888a24fe2a7f87b58","word":{"value":"amido","source":{"line":47441,"pointer":"/word"}},"pos":{"value":"noun","source":{"line":47441,"pointer":"/pos"}},"posTitle":{"value":"Sostantivo","source":{"line":47441,"pointer":"/pos_title"}},"tags":[{"value":"masculine","source":{"line":47441,"pointer":"/tags/0"}}],"rawTags":[],"senses":[{"index":0,"source":{"line":47441,"pointer":"/senses/0"},"glosses":[{"value":"composto organico, polisaccaride costituito da molecole di destroglicosio polimerizzate in due forme diverse, l'amilopectina e l'amilosio. Si forma nelle parti verdi delle piante per fotosintesi da anidride carbonica e acqua e si accumula come sostanza di riserva nelle radici, nei tuberi e nei semi in forma di granuli. Costituisce il carboidrato più importante per l'alimentazione e viene usato nella fabbricazione di adesivi, addensanti e carte speciali.","source":{"line":47441,"pointer":"/senses/0/glosses/0"}}],"labels":[],"formOf":[]},{"index":1,"source":{"line":47441,"pointer":"/senses/1"},"glosses":[{"value":"composto estratto dal frumento per macerazione, utile a dar la salda agli indumenti di biancheria","source":{"line":47441,"pointer":"/senses/1/glosses/0"}}],"labels":[],"formOf":[]}],"forms":[{"index":0,"source":{"line":47441,"pointer":"/forms/0"},"form":{"value":"amidi","source":{"line":47441,"pointer":"/forms/0/form"}},"tags":[{"value":"plural","source":{"line":47441,"pointer":"/forms/0/tags/0"}}],"rawTags":[]}],"grammar":{"record":[{"status":"stated","dimension":"gender","value":"masculine","sourceText":"masculine","source":{"line":47441,"pointer":"/tags/0"}},{"status":"missing","dimension":"number","source":{"line":47441,"pointer":""}}],"senses":[],"forms":[{"index":0,"claim":{"status":"stated","dimension":"number","value":"plural","sourceText":"plural","source":{"line":47441,"poin