{"schema":"lexema-content/v1","releaseId":"it-0c432803","entries":{"phrase:Locuzione nominale":{"key":"phrase:Locuzione nominale","sourceLineSha256":"6932bd166e400ec8ba5d62a9c1a635e48c4cd01fc78db49188441121219ab94a","word":{"value":"acido solfidrico","source":{"line":47241,"pointer":"/word"}},"pos":{"value":"phrase","source":{"line":47241,"pointer":"/pos"}},"posTitle":{"value":"Locuzione nominale","source":{"line":47241,"pointer":"/pos_title"}},"tags":[{"value":"masculine","source":{"line":47241,"pointer":"/tags/0"}},{"value":"noun","source":{"line":47241,"pointer":"/tags/1"}}],"rawTags":[],"senses":[{"index":0,"source":{"line":47241,"pointer":"/senses/0"},"glosses":[{"value":"composto chimico, idracido dello zolfo, gas incolore, dall' odore caratteristico delle uova marce, si rinviene in emanazioni vulcaniche, in giacimenti petroliferi ed in acque minerali; è tossico e può formare miscele esplosive con l' aria. Reagisce in presenza di acqua con tutti i metalli pesanti dando precipitati solitamente neri di solfuri. Si usa per produrre l' acido solforico, lo zolfo e composti organici solforati.","source":{"line":47241,"pointer":"/senses/0/glosses/0"}}],"labels":[],"formOf":[]}],"forms":[{"index":0,"source":{"line":47241,"pointer":"/forms/0"},"form":{"value":"acidi solfidrici","source":{"line":47241,"pointer":"/forms/0/form"}},"tags":[{"value":"plural","source":{"line":47241,"pointer":"/forms/0/tags/0"}}],"rawTags":[]}],"grammar":{"record":[{"status":"stated","dimension":"gender","value":"masculine","sourceText":"masculine","source":{"line":47241,"pointer":"/tags/0"}},{"status":"unclassified","sourceText":"noun","source":{"line":47241,"pointer":"/tags/1"}}],"senses":[],"forms":[{"index":0,"claim":{"status":"stated","dimension":"number","value":"plural","sourceText":"plural","source":{"line":47241,"pointer":"/forms/0/tags/0"}}}]}}}}
