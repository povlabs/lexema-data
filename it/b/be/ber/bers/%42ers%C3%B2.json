{"schema":"lexema-content/v1","releaseId":"it-0c432803","entries":{"noun:Sostantivo":{"key":"noun:Sostantivo","sourceLineSha256":"2ef29e0180f41317b27e84f82143adf84cc38829e7941332d3842384613ac6c8","word":{"value":"Bersò","source":{"line":592786,"pointer":"/word"}},"pos":{"value":"noun","source":{"line":592786,"pointer":"/pos"}},"posTitle":{"value":"Sostantivo","source":{"line":592786,"pointer":"/pos_title"}},"tags":[{"value":"invariable","source":{"line":592786,"pointer":"/tags/0"}},{"value":"masculine","source":{"line":592786,"pointer":"/tags/1"}}],"rawTags":[],"senses":[{"index":0,"source":{"line":592786,"pointer":"/senses/0"},"glosses":[{"value":"Piccola costruzione da giardino senza né mura, né tetto e costituita da un'armatura destinata a essere ricoperta da piante rampicanti ornamentali. È quasi sempre è a pianta centrale e l'armatura sommitale ha generalmente forma a cupola o a cono. Si differenzia dal gazebo perché non ha un vero tetto, e dalla pergola perché non copre un percorso, ma un punto di sosta dove leggere e conversare.","source":{"line":592786,"pointer":"/senses/0/glosses/0"}}],"labels":[],"formOf":[]}],"forms":[],"grammar":{"record":[{"status":"stated","dimension":"number","value":"invariable","sourceText":"invariable","source":{"line":592786,"pointer":"/tags/0"}},{"status":"stated","dimension":"gender","value":"masculine","sourceText":"masculine","source":{"line":592786,"pointer":"/tags/1"}}],"senses":[],"forms":[]}}}}
